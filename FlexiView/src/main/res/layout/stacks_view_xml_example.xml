<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Title for the example -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:text="FlexiView XML Stack Example"
        android:textColor="#333333"
        android:textSize="24sp"
        android:textStyle="bold" />
    
    <!-- Container for the StacksView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="80dp">
        
        <!-- StacksView with directly declared children -->
        <com.mayur.flexiview.StacksView
            android:id="@+id/stacks_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="24dp"
            app:visibleItems="4"
            app:scaleDecrement="0.08"
            app:yOffset="24dp"
            app:xOffset="12dp"
            app:rotationMax="3">
            
            <!-- Minecraft Card -->
            <com.mayur.flexiview.DrawableRelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundColor="#4285F4"
                app:cornerRadius="40dp"
                app:shadowColor="#80000000"
                app:shadowRadius="20dp"
                app:shadowDx="5dp"
                app:shadowDy="10dp"
                app:gradientStartColor="#4285F4"
                app:gradientEndColor="#2E5AA6"
                app:gradientAngle="90">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:padding="40dp"
                    android:text="Minecraft"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                
            </com.mayur.flexiview.DrawableRelativeLayout>
            
            <!-- Avengers Card -->
            <com.mayur.flexiview.DrawableRelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundColor="#EA4335"
                app:cornerRadius="40dp"
                app:shadowColor="#80000000"
                app:shadowRadius="20dp"
                app:shadowDx="5dp"
                app:shadowDy="10dp"
                app:gradientStartColor="#EA4335"
                app:gradientEndColor="#A32E24"
                app:gradientAngle="90">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:padding="40dp"
                    android:text="Avengers"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                
            </com.mayur.flexiview.DrawableRelativeLayout>
            
            <!-- Spider-Man Card -->
            <com.mayur.flexiview.DrawableRelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundColor="#FBBC04"
                app:cornerRadius="40dp"
                app:shadowColor="#80000000"
                app:shadowRadius="20dp"
                app:shadowDx="5dp"
                app:shadowDy="10dp"
                app:gradientStartColor="#FBBC04"
                app:gradientEndColor="#B08402"
                app:gradientAngle="90">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:padding="40dp"
                    android:text="Spider-Man"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                
            </com.mayur.flexiview.DrawableRelativeLayout>
            
            <!-- Dune Card -->
            <com.mayur.flexiview.DrawableRelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundColor="#34A853"
                app:cornerRadius="40dp"
                app:shadowColor="#80000000"
                app:shadowRadius="20dp"
                app:shadowDx="5dp"
                app:shadowDy="10dp"
                app:gradientStartColor="#34A853"
                app:gradientEndColor="#24763A"
                app:gradientAngle="90">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:padding="40dp"
                    android:text="Dune"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                
            </com.mayur.flexiview.DrawableRelativeLayout>
            
            <!-- Star Wars Card -->
            <com.mayur.flexiview.DrawableRelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundColor="#9C27B0"
                app:cornerRadius="40dp"
                app:shadowColor="#80000000"
                app:shadowRadius="20dp"
                app:shadowDx="5dp"
                app:shadowDy="10dp"
                app:gradientStartColor="#9C27B0"
                app:gradientEndColor="#6D1B7B"
                app:gradientAngle="90">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:padding="40dp"
                    android:text="Star Wars"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                
            </com.mayur.flexiview.DrawableRelativeLayout>
            
        </com.mayur.flexiview.StacksView>
            
    </FrameLayout>
    
    <!-- Navigation buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal">
        
        <Button
            android:id="@+id/button_previous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Previous" />
            
        <Button
            android:id="@+id/button_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Next" />
            
    </LinearLayout>

</FrameLayout> 