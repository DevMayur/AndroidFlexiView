<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="DrawableRelativeLayout">
        <attr name="backgroundColor" format="color" />
        <attr name="strokeColor" format="color" />
        <attr name="strokeWidth" format="dimension" />
        <attr name="cornerRadiusTopLeft" format="dimension" />
        <attr name="cornerRadiusTopRight" format="dimension" />
        <attr name="cornerRadiusBottomRight" format="dimension" />
        <attr name="cornerRadiusBottomLeft" format="dimension" />
        <attr name="gradientStartColor" format="color" />
        <attr name="gradientEndColor" format="color" />
        <attr name="gradientAngle" format="float" />
        <attr name="colors" format="reference"/>
        <attr name="positions" format="string"/>
        <attr name="cornerRadius" format="dimension"/>
        <attr name="padding" format="dimension"/>
        <attr name="avoidRadiusPadding" format="boolean"/>
        <attr name="avoidStrokePadding" format="boolean"/>
        <attr name="blurRadius" format="dimension"/>
        <attr name="blurColor" format="color"/>
        <attr name="gradientType" format="enum">
            <enum name="linear" value="0"/>
            <enum name="radial" value="1"/>
            <enum name="sweep" value="2"/>
        </attr>
        <attr name="reverseGradient" format="boolean"/>

        <!-- Shadow Effects -->
        <attr name="shadowColor" format="color"/>
        <attr name="shadowRadius" format="dimension"/>
        <attr name="shadowDx" format="dimension"/>
        <attr name="shadowDy" format="dimension"/>

        <!-- Border Styles -->
        <attr name="borderStyle" format="enum">
            <enum name="solid" value="0"/>
            <enum name="dashed" value="1"/>
            <enum name="dotted" value="2"/>
        </attr>
        <attr name="dashWidth" format="dimension"/>
        <attr name="dashGap" format="dimension"/>

        <!-- Gradient Center Point -->
        <attr name="gradientCenterX" format="float"/>
        <attr name="gradientCenterY" format="float"/>
        <attr name="gradientRadius" format="dimension"/>

        <!-- Ripple Effect -->
        <attr name="rippleColor" format="color"/>
        <attr name="rippleEnabled" format="boolean"/>

        <!-- State-based Colors -->
        <attr name="backgroundColorPressed" format="color"/>
        <attr name="backgroundColorDisabled" format="color"/>
        <attr name="strokeColorPressed" format="color"/>
        <attr name="strokeColorDisabled" format="color"/>

        <!-- Animation -->
        <attr name="animationDuration" format="integer"/>

        <!-- Blur Edge -->
        <attr name="blurEdge" format="boolean"/>
        <attr name="blurEdgeRadius" format="dimension"/>

        <!-- Gradient Spread -->
        <attr name="gradientSpread" format="enum">
            <enum name="pad" value="0"/>
            <enum name="repeat" value="1"/>
            <enum name="mirror" value="2"/>
        </attr>

        <!-- Corner Style -->
        <attr name="cornerStyle" format="enum">
            <enum name="rounded" value="0"/>
            <enum name="cut" value="1"/>
        </attr>

        <!-- Border Alignment -->
        <attr name="borderAlignment" format="enum">
            <enum name="inside" value="0"/>
            <enum name="center" value="1"/>
            <enum name="outside" value="2"/>
        </attr>

        <!-- Gradient Interpolation -->
        <attr name="gradientInterpolation" format="enum">
            <enum name="linear" value="0"/>
            <enum name="accelerate" value="1"/>
            <enum name="decelerate" value="2"/>
        </attr>

        <!-- Blur Quality -->
        <attr name="blurQuality" format="enum">
            <enum name="low" value="0"/>
            <enum name="medium" value="1"/>
            <enum name="high" value="2"/>
        </attr>

        <!-- State-based Corner Radius -->
        <attr name="cornerRadiusPressed" format="dimension"/>
        <attr name="cornerRadiusDisabled" format="dimension"/>
    </declare-styleable>

    <!-- StacksView Attributes -->
    <declare-styleable name="StacksView">
        <!-- Number of visible items in the stack -->
        <attr name="visibleItems" format="integer"/>
        <!-- Scale decrement for each successive item in the stack -->
        <attr name="scaleDecrement" format="float"/>
        <!-- Vertical offset for each successive item in the stack -->
        <attr name="yOffset" format="dimension"/>
        <!-- Horizontal offset for each successive item in the stack -->
        <attr name="xOffset" format="dimension"/>
        <!-- Maximum random rotation applied to items in the stack -->
        <attr name="rotationMax" format="integer"/>
    </declare-styleable>
</resources>